{
  "name": "pc-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "A fully static, browser-storage PC parts and computer inventory tracker.",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "serve": "http-server app -p 8080 -c-1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1"
  }
}
